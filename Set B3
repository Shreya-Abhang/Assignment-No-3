<html>
<head>
    <title>Even or odd</title>
</head>
<body>
    <script>
        function evenodd() {
            var number = parseInt(prompt("Enter a Number"));
            if (number % 2 == 0) {
                window.alert(number + " is even");
            } else {
                window.alert(number + " is odd");
            }
        }
        evenodd();
    </script>
</body>
</html>
