<html>
<head>
    <title>Factorial</title>
</head>
<body>
    <script type="text/javascript">
        function factorial() {
            var n = parseInt(prompt("Enter a number:"));
            var fact = 1;
            for (var i = 1; i <= n; i++) {
                fact = fact * i;
            }
            document.write("Factorial is " + fact);
        }
        factorial();
    </script>
</body>
</html>
